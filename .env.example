# API Keys for different LLM providers
# You need at least one API key for each model you want to use

# Anthropic Claude API Key
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key
# Get your key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# xAI Grok API Key
# Get your key from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Server Port (optional, defaults to 8001)
# PORT=8001

# CORS Allowed Origins (optional, defaults to localhost for development)
# In production, this is automatically configured
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
